# Copy this file to .env and add your OpenAI API key.
OPENAI_API_KEY=
# Optional server-side AI settings for analysis, PPT, and email drafts.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
# Dashboard analysis cache lifetime (seconds); defaults to 24 hours.
AI_ANALYSIS_CACHE_TTL_SECONDS=86400

# multi (default) or single (legacy fallback / benchmark).
AI_ANALYSIS_MODE=multi
# Optional validated hand-off JSON/Markdown and request metrics; ignored by Git.
# AI_AGENT_TRACE_DIR=.cache/agent-traces
